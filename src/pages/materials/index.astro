---
import MaterialsLayout from '../../layouts/MaterialsLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('materials');

// Keep a few featured images for the main gallery,
// or pull them from projects if they exist
const featuredImages = projects.length > 0
    ? projects.flatMap(p => p.data.galleryImages)
    : [
        '/materials/sample_1.jpeg',
        '/materials/sample_2.jpeg',
        '/materials/sample_3.jpeg',
        '/materials/sample_4.jpg',
        '/materials/sample_5.jpg',
        '/materials/sample_6.jpg',
        '/materials/sample_7.jpg',
        '/materials/sample_8.jpg',
        '/materials/sample_9.jpeg',
        '/materials/sample_10.jpeg',
        '/materials/sample_11.jpeg',
        '/materials/sample_12.jpeg',
        '/materials/sample_13.jpeg'
      ];

// Real pixel dimensions of each gallery image, so the browser can reserve
// space before the files finish loading and the CSS columns don't reflow
const IMG_DIMS = {
    'sample_1.jpeg': [960, 655],
    'sample_2.jpeg': [558, 960],
    'sample_3.jpeg': [720, 960],
    'sample_4.jpg': [720, 960],
    'sample_5.jpg': [720, 960],
    'sample_6.jpg': [720, 960],
    'sample_7.jpg': [720, 960],
    'sample_8.jpg': [720, 960],
    'sample_9.jpeg': [960, 960],
    'sample_10.jpeg': [720, 960],
    'sample_11.jpeg': [641, 960],
    'sample_12.jpeg': [960, 640],
    'sample_13.jpeg': [641, 960]
};

// Split the images into two photo columns of equal visual height so the
// columns line up at the bottom. Each item's weight is its rendered height
// at a fixed column width plus the row gap, and a subset-sum DP finds the
// split closest to half the total height. Runs at build time, on the
// rendered pixel list, so any future image swap gets rebalanced too.
function partitionTwoColumns(sources) {
    const COL_WIDTH = 380;   // px, approx column width at max-width 800
    const ROW_GAP = 24;      // px, matches margin-bottom in materials.css
    const weight = (src) => {
        const dims = IMG_DIMS[src.split('/').pop()];
        const h = dims ? (dims[1] / dims[0]) * COL_WIDTH : COL_WIDTH;
        return Math.round(h + ROW_GAP);
    };
    const weights = sources.map(weight);
    const total = weights.reduce((a, b) => a + b, 0);
    const target = Math.round(total / 2);

    let dp = new Map([[0, []]]);
    for (let i = 0; i < weights.length; i++) {
        const next = new Map(dp);
        for (const [h, idxs] of dp) {
            const nh = h + weights[i];
            if (!next.has(nh)) next.set(nh, [...idxs, i]);
        }
        dp = next;
    }
    let best = [];
    let bestDiff = Infinity;
    for (const [h, idxs] of dp) {
        const diff = Math.abs(h - target);
        if (diff < bestDiff) { bestDiff = diff; best = idxs; }
    }
    const colA = best.map(i => ({ src: sources[i], index: i }));
    const colB = sources
        .map((src, i) => ({ src, index: i }))
        .filter(item => !best.includes(item.index));
    return [colA, colB];
}

const columns = partitionTwoColumns(featuredImages);
---

<MaterialsLayout title="Material Worlds">
    <article style="max-width: 800px; margin: 0 auto; line-height: 1.8;">
        <section style="margin-bottom: 6rem;">
            <div class="plas-gallery">
                {columns.map(col => (
                    <div class="plas-gallery-col">
                        {col.map(({src, index}) => {
                            const dims = IMG_DIMS[src.split('/').pop()];
                            return (
                            <div class="plas-gallery-item">
                                <img src={src} alt={`Plastering work ${index + 1}`} class="plas-gallery-img"
                                    width={dims ? dims[0] : undefined}
                                    height={dims ? dims[1] : undefined} />
                            </div>
                            );
                        })}
                    </div>
                ))}
            </div>
        </section>
    </article>

    <div id="plas-modal" class="plas-modal">
        <span class="plas-modal-close">&times;</span>
        <img id="plas-modal-img" class="plas-modal-content" src="" alt="Gallery View" />
    </div>

    <script>
        const modal = document.getElementById('plas-modal');
        const modalImg = document.getElementById('plas-modal-img');
        const closeBtn = document.querySelector('.plas-modal-close');
        const galleryImgs = document.querySelectorAll('.plas-gallery-img');

        galleryImgs.forEach(img => {
            img.addEventListener('click', () => {
                modal.classList.add('active');
                modalImg.src = img.src;
            });
        });

        const closeModal = () => {
            modal.classList.remove('active');
            modalImg.src = '';
        };

        closeBtn.addEventListener('click', closeModal);
        modal.addEventListener('click', (e) => {
            if (e.target !== modalImg) closeModal();
        });
    </script>
</MaterialsLayout>
